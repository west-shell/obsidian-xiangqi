{
  "name": "obsidian-xiangqi",
  "private": true,
  "version": "4.21.0",
  "description": "Render xiangqi(Chinese chess) positions diagrams in a note.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "fmt": "prettier --write src",
    "fmt:check": "prettier --check src",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "dev": "vite build --mode development && node -e \"require('fs').copyFileSync('manifest.json', './test-vault/.obsidian/plugins/xiangqi/manifest.json')\"",
    "build": "vite build --mode production-min && node -e \"require('fs').copyFileSync('manifest.json', 'build/manifest.json')\"",
    "build:debug": "vite build --mode production && node -e \"require('fs').copyFileSync('manifest.json', 'build/manifest.json')\"",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:watch": "vitest watch",
    "release": "node scripts/release.mjs",
    "prepare": "simple-git-hooks"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "svelte",
    "svelte5",
    "typescript"
  ],
  "author": "weshell",
  "authorUrl": "https://space.bilibili.com/156446344",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.19.2",
    "@weshell/xiangqi.js": "^1.0.6",
    "@weshell/xiangqiground": "^1.1.1",
    "d3": "^7.9.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-svelte": "^3.24.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "nano-staged": "^1.0.2",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.107.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tslib": "^2.9.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,html,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13"
  }
}
